# Copy to .env and adjust if needed. docker-compose.yml reads these too.
POSTGRES_USER=remo
POSTGRES_PASSWORD=remo
POSTGRES_DB=remo
POSTGRES_PORT=5432

# Used by the app and by scripts/db-check.mjs
DATABASE_URL=postgres://remo:remo@localhost:5432/remo

# ------------------------------------------------------------ test database --
# Tests NEVER use DATABASE_URL or this file. They read REMO_TEST_POSTGRES_URL, whose
# default is the dedicated Compose server in docker-compose.test.yml:
#   postgres://remo_test:remo_test@127.0.0.1:55432/remo_test_control
# Start/check it with `pnpm test:db:up` and `pnpm test:db:check`.
# REMO_TEST_POSTGRES_URL=postgres://remo_test:remo_test@127.0.0.1:55432/remo_test_control

# Sync service endpoint used by apps/web. Leave it unset to use the app's own origin
# (the dev server proxies /sync to the service above), which is what makes a
# single forwarded port enough for a teammate on another machine.
# VITE_SYNC_URL=ws://localhost:1234

# ---------------------------------------------------------------- production --
# The sync service reads these from its environment, not from this file, unless the
# process is started with an EnvironmentFile (see deploy/remo-sync.service).
# Keep the real values in /srv/remo/.env with mode 600.
#
# NODE_ENV=production
# PORT=1234
# REMO_APP_ORIGIN=https://boards.example.com
# REMO_CORS_ORIGIN=https://boards.example.com
# REMO_METRICS_TOKEN=replace-with-32-random-bytes
# REMO_DATA_DIR=/var/lib/remo
#
# Postgres should not listen on the internet: POSTGRES_PORT=127.0.0.1:5432.

# ------------------------------------------------------------- AI agents --
# Any OpenAI-compatible chat-completions endpoint. Without a key, agent tasks fail
# with AI_NOT_CONFIGURED; the rest of the product keeps working.
# REMO_AI_API_KEY=
# REMO_AI_BASE_URL=https://openrouter.ai/api/v1
# REMO_AI_MODEL=
# REMO_AI_TIMEOUT_MS=60000
# REMO_AI_PRICE_INPUT_PER_MTOK=0
# REMO_AI_PRICE_OUTPUT_PER_MTOK=0
# REMO_AGENT_MAX_TOKENS=32000
# REMO_AGENT_MAX_COST_USD=2
# REMO_AGENT_MAX_ACTIONS=80
# REMO_AGENT_MAX_QUEUED=5

# Provider keys added in the UI are encrypted with a KEK that is not stored in the
# database. Generate once with: openssl rand -base64 32. Back it up.
# REMO_KEK=
# Dev only: VPN fake-IP (198.18.0.0/15) for provider hosts. Never in production.
# REMO_AI_ALLOW_PRIVATE=1
# REMO_KEK_ID=v1
# A self-hosted installation may deliver webhooks to its own network; off by default.
# REMO_WEBHOOK_ALLOW_PRIVATE=0

# Evidential log anchor: a directory outside the database, or an append-only endpoint.
# REMO_AI_ANCHOR_DIR=/var/lib/remo/ai-anchors
# REMO_AI_ANCHOR_URL=
# REMO_AI_ANCHOR_TOKEN=
# REMO_AGENT_MAX_ACTIONS=500

# Product metrics: a separate database, never the board database (ADR-082).
# Empty means instrumentation is a no-op. REMO_METRICS=off disables it explicitly.
REMO_METRICS_DATABASE_URL=postgres://remo:remo@localhost:5432/remo_metrics
REMO_METRICS=off
