{
  "name": "remo",
  "private": true,
  "version": "0.2.1",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "templates": "node scripts/author-templates.mjs && node scripts/sync-templates.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:check": "node scripts/db-check.mjs",
    "db:bench": "node scripts/db-bench.mjs",
    "db:prune": "node scripts/db-prune.mjs",
    "db:orphans": "node scripts/ownerless-boards.mjs",
    "db:repaint": "node scripts/repaint-paper.mjs",
    "db:rls": "node scripts/rls-inventory.mjs",
    "db:rls:setup": "node scripts/db-rls-setup.mjs",
    "db:rls:enable": "node scripts/db-rls-enable.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:backup:list": "node scripts/db-backup.mjs --list",
    "db:restore": "node scripts/db-backup.mjs --restore",
    "test:db:up": "docker compose -p remo-test -f docker-compose.test.yml up -d --wait && pnpm test:db:init",
    "test:db:init": "node scripts/test-db-init.mjs",
    "test:db:check": "node scripts/test-db-check.mjs",
    "test:db:down": "docker compose -p remo-test -f docker-compose.test.yml down",
    "test:db:logs": "docker compose -p remo-test -f docker-compose.test.yml logs -f postgres",
    "sync": "pnpm --filter @remo/sync start",
    "sync:smoke": "pnpm --filter @remo/sync smoke",
    "dev:web": "pnpm templates && pnpm --filter @remo/web dev",
    "dev:lan": "pnpm templates && pnpm --filter @remo/web dev --host",
    "dev": "pnpm templates && pnpm --filter @remo/web dev",
    "build": "pnpm templates && pnpm --filter @remo/web build",
    "typecheck": "pnpm templates && node scripts/docs-build.mjs --check && pnpm --filter @remo/web exec tsc --noEmit && pnpm --filter @remo/ui typecheck",
    "lint": "biome lint apps packages scripts e2e --reporter=summary",
    "lint:strict": "biome lint apps packages scripts e2e --error-on-warnings",
    "audit:prod": "node scripts/dependency-audit.mjs",
    "test": "REMO_TEST_RUN=$$_$(node -p \"require('node:crypto').randomBytes(4).toString('hex')\") vitest run",
    "test:watch": "REMO_TEST_RUN=$$_$(node -p \"require('node:crypto').randomBytes(4).toString('hex')\") vitest",
    "ds:tokens": "node packages/ui/scripts/build-tokens.mjs",
    "ds:contrast": "node packages/ui/scripts/contrast.mjs",
    "ds:lint": "pnpm --filter @remo/ui lint:css",
    "ds:check": "node packages/ui/scripts/build-tokens.mjs --check && node packages/ui/scripts/contrast.mjs && pnpm ds:lint",
    "stack": "pnpm db:up && pnpm db:check && pnpm sync",
    "docs:build": "node scripts/docs-build.mjs",
    "docs:accept": "node scripts/docs-build.mjs --accept-translations",
    "docs:check": "node scripts/docs-build.mjs --check",
    "db:metrics": "node scripts/metrics-db.mjs",
    "acceptance:stage2": "node scripts/acceptance-stage2.mjs",
    "version:show": "node scripts/version.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "e2e": "node scripts/e2e-run.mjs",
    "e2e:headed": "node scripts/e2e-run.mjs --headed",
    "baselines": "REMO_UPDATE_BASELINES=1 node scripts/e2e-run.mjs e2e/visual.spec.ts",
    "e2e:visual": "node scripts/e2e-run.mjs e2e/visual.spec.ts",
    "e2e:a11y": "node scripts/e2e-run.mjs e2e/a11y.spec.ts",
    "e2e:perf": "node scripts/e2e-run.mjs e2e/perf.spec.ts",
    "size:check": "node scripts/file-size-check.mjs",
    "ui:check": "node scripts/ui-rules-check.mjs",
    "state:check": "node scripts/state-report.mjs",
    "state:write": "node scripts/state-report.mjs --write",
    "state:report": "node scripts/state-report.mjs --print",
    "guide:build": "node scripts/guide-build.mjs",
    "guide:accept": "node scripts/guide-build.mjs --accept-translations",
    "guide:check": "node scripts/guide-build.mjs --check",
    "guide:serve": "node scripts/guide-serve.mjs",
    "guide:dev": "node scripts/guide-build.mjs && node scripts/guide-serve.mjs",
    "guide:audit": "node scripts/guide-audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.64.1",
    "markdown-it": "^15.0.3",
    "pg": "^8.13.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "license": "AGPL-3.0-only",
  "author": "Alexander Kostylev",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaggalex/remo.git"
  },
  "homepage": "https://remo.letii.ru"
}
