# Store as /srv/remo/shared/production.env, mode 600; never copy your development .env.
# Provision this role in the shared server first. Hex passwords avoid URL escaping.
REMO_DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
REMO_DB_HOST=shared-postgres
REMO_DB_NETWORK=remo_database
# The service connects as the DML-only role created by `pnpm db:rls:setup`; schema,
# the legacy repair and the RLS tools use the owner URL (ADR-178). For local development
# without RLS both may point at the owner.
REMO_APP_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_RAND_HEX_32
DATABASE_URL=postgres://remo_app:REPLACE_WITH_THE_APP_PASSWORD@shared-postgres:5432/remo
REMO_MIGRATION_DATABASE_URL=postgres://remo:REPLACE_WITH_THE_SAME_PASSWORD@shared-postgres:5432/remo
REMO_KEK=REPLACE_WITH_OPENSSL_RAND_BASE64_32
REMO_KEK_ID=v1
REMO_METRICS_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
REMO_APP_ORIGIN=https://boards.example.com
REMO_CORS_ORIGIN=https://boards.example.com
REMO_DOCS_ORIGIN=https://docs.boards.example.com
REMO_EDGE_NETWORK=remo_edge
REMO_METRICS=off
# Provider keys can be entered through the app; no global AI key is required.
