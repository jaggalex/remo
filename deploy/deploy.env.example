# Release configuration for deploy/release.sh.
#
# Copy this file to .config/remo/deploy.env, keep it private (chmod 600), and replace
# the values. The script reads it as data — plain KEY=VALUE lines, no shell — and
# refuses a file it does not own, a file others can read, or a symlink.
REMO_DEPLOY_HOST=deploy@your-host
REMO_APP_ORIGIN=https://boards.example.com
REMO_DOCS_ORIGIN=https://docs.example.com
